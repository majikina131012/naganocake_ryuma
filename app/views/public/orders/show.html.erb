<h1>注文履歴詳細</h1>
<h3 class="text-info">注文詳細</h3>
<table>
  <tr>
    <th>注文日</th>
    <th>配送先</th>
    <th>支払方法</th>
    <th>注文ステータス</th>
    <th>小計</th>
    <th>送料</th>
    <th>総計</th>
  </tr>
  <tr>
    <td><%= l @order.created_at %></td>
    <td>〒<%= @order.postal_code%>  <%= @order.address %>  <%= @order.name %></td>
    <td><%= @order.payment_method_i18n%></td>
    <td><%= @order.status_i18n %></td>
    <td><%= @order.order_details.sum(&:subtotal) %>円</td>
    <td><%= @order.postage %>円</td>
    <td><%= @order.billing_amount %>円</td>
  </tr>
</table>
<h3 class="text-info">注文商品詳細</h3>
<table>
  <tr>
    <th>商品名</th>
    <th>単価(税込)</th>
    <th>個数</th>
    <th>合計</th>
  </tr>
  <% @order_details.each do |order_detail| %>
    <tr>
      <td><%= link_to order_detail.item.name, item_path %></td>
      <td><%= order_detail.item.with_tax_price %>円</td>
      <td><%= order_detail.amount %></td>
      <td><%= order_detail.subtotal %>円</td>
    </tr>
  <% end %>
</table>