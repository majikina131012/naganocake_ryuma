<h1>会員一覧</h1>


<table>
  <thead>
    <tr>
      <th>会員ID</th>
      <th>名前</th>
      <th>メールアドレス</th>
      <th>ステータス</th>
      <th>詳細</th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
    <tr>
      <td><%= customer.id %></td>
      <td><%= customer.last_name %>/<%= customer.first_name %></td>
      <td><%= customer.email %></td>
      <td>
        <% if customer.is_deleted == false %>
          有効
        <% else %>
          退会済み
        <% end %>
      </td>
      <td>
        <%= link_to '詳細情報', admin_customer_path(customer.id) %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>


